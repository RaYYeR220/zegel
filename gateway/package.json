{
  "name": "@zegel/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CCIP-Read gateway for ZegelResolver. Serves the public sealed envelope and nothing else.",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "publish-envelope": "node scripts/publish.ts",
    "write-feed": "node scripts/write-feed.ts",
    "build": "esbuild vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/node": "^24",
    "esbuild": "^0.25.12",
    "hono": "^4.13.5",
    "typescript": "^5.7.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@ethersphere/bee-js": "13.0.0",
    "@noble/hashes": "^1.8.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
