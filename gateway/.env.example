# The key the gateway signs responses with. Its address must be allowlisted on the
# resolver: `cast send <resolver> "setSigner(address,bool)" <address> true`.
# Unset in development, a throwaway key is generated at boot and /health says so.
ZEGEL_SIGNER_KEY=

# The deployed ZegelResolver(s) this gateway will sign for. Unset means it signs for
# whatever resolver address asks, which /health reports as degraded.
ZEGEL_RESOLVERS=

# Chain the resolver lives on. Binds the EIP-712 domain a publisher signs against.
ZEGEL_CHAIN_ID=1

# Read-only RPC. Used to resolve name ownership from the ENS registry, to verify
# ERC-1271 signatures from contract-owned names, and to check that the resolver
# really does allowlist this signer. Without it those probes report as skipped.
ZEGEL_RPC_URL=

# Optional. The ENS registry, if not mainnet's.
ZEGEL_ENS_REGISTRY=

# Optional. A wrapped .eth name has the NameWrapper as its registry owner; set this
# to follow the second hop to the real owner.
ZEGEL_NAME_WRAPPER=

# Local runs with no RPC: node=owner pairs, comma separated.
# ZEGEL_NAME_OWNERS=0x787192fc5378cc32aa956ddfdedbf26b24e8d78e40109add0eea2c1a012c3dec=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ZEGEL_NAME_OWNERS=

# Where envelopes come from: swarm-feed, file or memory.
#   swarm-feed  reads the current envelope out of a Swarm feed on every request and
#               holds nothing. The only option that works on serverless, and the
#               default everywhere except the long-running Node entry point.
#   file        one JSON file. Needs a durable disk; the default for `node src/index.ts`.
#   memory      tests, and a Worker seeded from ZEGEL_ENVELOPES.
ZEGEL_STORE=swarm-feed
ZEGEL_STORE_PATH=.zegel/envelopes.json

# The address whose Swarm feed is authoritative. Required for ZEGEL_STORE=swarm-feed;
# `scripts/write-feed.ts` prints it.
ZEGEL_FEED_OWNER=

# Bee API used for feed reads. Reads are free and unauthenticated on the public
# gateway, so a deployed gateway needs no node of its own.
ZEGEL_BEE_URL=https://api.gateway.ethswarm.org

# Seconds a feed read is cached. A cached envelope never outlives its own expiresAt.
ZEGEL_FEED_CACHE_TTL=15

# Seconds a signed response stays valid on chain, and how long an HTTP cache may
# hold it. The cache TTL is clamped to the signature TTL.
ZEGEL_SIGNATURE_TTL=60
ZEGEL_CACHE_TTL=30

ZEGEL_PORT=8787

# --- writer only, never set on the deployed gateway -------------------------------
# scripts/write-feed.ts signs the feed with this key and pays with this batch. They
# belong on the issuer's own machine, next to their Bee node.
# ZEGEL_FEED_KEY=
# ZEGEL_POSTAGE_BATCH=
