{
  "name": "@zegel/solana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solana Attestation Service anchor for Zegel references: issue, revoke, verify.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "zegel-sas": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node src/cli/index.ts",
    "zegel-sas": "node src/cli/index.ts"
  },
  "dependencies": {
    "@solana-program/compute-budget": "0.18.1",
    "@solana-program/token-2022": "0.16.1",
    "@solana/kit": "8.2.0",
    "sas-lib": "1.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "sas-lib>@solana/kit": "8.2.0"
    }
  }
}
