{
  "name": "@zegel/evidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobula evidence collection and deterministic claim derivation for Zegel references.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "record": "vitest run scripts/fixtures.record.ts"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
