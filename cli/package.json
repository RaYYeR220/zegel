{
  "name": "@zegel/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Zegel command line: scan an address, issue a reference, verify one, grant and revoke access.",
  "bin": {
    "zegel": "./bin/zegel.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "zegel": "node bin/zegel.mjs",
    "doctor": "node bin/zegel.mjs doctor",
    "scan": "node bin/zegel.mjs scan",
    "issue": "node bin/zegel.mjs issue",
    "verify": "node bin/zegel.mjs verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "12.1.0",
    "tsx": "4.20.6",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
